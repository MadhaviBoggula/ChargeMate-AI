# ChargeMate AI - environment template
# Copy to .env at the REPO ROOT (backend reads ../.env) and fill in real values.
# NEVER commit the real .env.

# --- Database (Neon PostgreSQL, pooled endpoint) ---
DATABASE_URL="postgresql://<user>:<password>@<host-pooler>/<db>?sslmode=require"

# --- LLM provider (OpenRouter, OpenAI-compatible) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
MAX_TOOL_CALL_ROUNDS=5

# --- MCP servers (registered by Members 2/3; leave empty until deployed) ---
MCP_OWNER_SERVER_URL=
MCP_DRIVER_SERVER_URL=

# --- RAG: local sentence-transformers embeddings (no API key needed) ---
# Keep RAG_EMBEDDING_DIMENSIONS in sync with the model (all-MiniLM-L6-v2 = 384).
RAG_SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2
RAG_EMBEDDING_DIMENSIONS=384
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
RAG_MIN_SCORE=0.35

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
