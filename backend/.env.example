APP_NAME=ChargeMate AI API
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
DEBUG=false

API_V1_PREFIX=/api/v1

# PostgreSQL with pgvector (Neon or local)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/chargemate

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
MAX_TOOL_CALL_ROUNDS=5

# MCP server connections used by the backend.
# Local development: a stdio command, e.g.
#   MCP_OWNER_SERVER_URL=.venv/bin/python -m app.mcp.owner_server
# Docker: leave the compose-provided HTTP URLs in place.
MCP_OWNER_SERVER_URL=
MCP_DRIVER_SERVER_URL=

# MCP server runtime (used by app.mcp.owner_server / driver_server)
MCP_TRANSPORT=stdio
MCP_OWNER_HOST=127.0.0.1
MCP_OWNER_PORT=8101
MCP_DRIVER_HOST=127.0.0.1
MCP_DRIVER_PORT=8102

EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
RAG_SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2
RAG_EMBEDDING_DIMENSIONS=384
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
RAG_MIN_SCORE=0.35
