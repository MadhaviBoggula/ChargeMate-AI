function AuthShell({
  children,
  title,
  subtitle,
  promoImage,
  promoTitle,
}: {
  children: React.ReactNode
  title: string
  subtitle: string
  promoImage: string
  promoTitle: string
}) {
  return (
    <main className="auth-page">
      <div className="auth-decoration">
        <img
          className="auth-background-image"
          src={promoImage}
          alt=""
          aria-hidden="true"
        />
        <div className="auth-image-overlay" />
        <Brand light />
        <div className="auth-promo">
          <span className="eyebrow">A SMARTER WAY TO CHARGE</span>
          <h2>{promoTitle}</h2>
        </div>
        <span className="auth-footnote">
          CHARGEMATE · INTELLIGENT EV CHARGING
        </span>
      </div>
      <div className="auth-main">
        <div className="auth-form-wrap">
          <div className="mobile-auth-brand"><Brand /></div>
          <div className="auth-heading">
            <span className="eyebrow">WELCOME TO CHARGEMATE</span>
            <h1>{title}</h1>
            <p>{subtitle}</p>
          </div>
          {children}
        </div>
      </div>
    </main>
  )
}

function LoginPage() {
  const { login } = useAuth()
  const navigate = useNavigate()
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [error, setError] = useState('')
  const [submitting, setSubmitting] = useState(false)

  async function handleSubmit(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault()
    setError('')
    setSubmitting(true)
    try {
      await login({ email, password })
      navigate('/stations', { replace: true })
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Unable to log in. Please try again.')
    } finally {
      setSubmitting(false)
    }
  }

  return (
    <AuthShell title="Welcome back" subtitle="Sign in to continue your charging journey." promoImage="/images/loginpage.png" promoTitle="Your Electric City Starts Here">
      <form className="auth-form" onSubmit={handleSubmit}>
        {error && <div className="form-error" role="alert">{error}</div>}
        <label htmlFor="login-email">Email address</label>
        <input id="login-email" type="email" autoComplete="email" placeholder="you@example.com" required value={email} onChange={e => setEmail(e.target.value)} />
        <label htmlFor="login-password">Password</label>
        <input id="login-password" type="password" autoComplete="current-password" placeholder="Enter your password" required value={password} onChange={e => setPassword(e.target.value)} />
        <button className="button button-primary auth-submit" type="submit" disabled={submitting}>
          {submitting ? 'Signing in...' : 'Sign in'} <ArrowRight size={17} />
        </button>
      </form>
      <p className="auth-switch">New to ChargeMate? <Link to="/register">Create an account</Link></p>
      <Link className="back-home" to="/">← Back to home</Link>
    </AuthShell>
  )
}

function RegisterPage() {
  const { register } = useAuth()
  const navigate = useNavigate()
  const [name, setName] = useState('')
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [role, setRole] = useState<'driver' | 'owner'>('driver')
  const [error, setError] = useState('')
  const [submitting, setSubmitting] = useState(false)

  async function handleSubmit(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault()
    setError('')
    setSubmitting(true)
    try {
      await register({ name, email, password, role })
      navigate('/stations', { replace: true })
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Unable to create your account. Please try again.')
    } finally {
      setSubmitting(false)
    }
  }

  return (
    <AuthShell title="Create your account" subtitle="Join ChargeMate and make your charging experience smarter." promoImage="/images/registrationpage.png" promoTitle="Your Electric City Journey Starts Here">
      <form className="auth-form" onSubmit={handleSubmit}>
        {error && <div className="form-error" role="alert">{error}</div>}
        <label htmlFor="register-name">Full name</label>
        <input id="register-name" autoComplete="name" placeholder="Your name" minLength={4} maxLength={255} required value={name} onChange={e => setName(e.target.value)} />
        <label htmlFor="register-email">Email address</label>
        <input id="register-email" type="email" autoComplete="email" placeholder="you@example.com" required value={email} onChange={e => setEmail(e.target.value)} />
        <label htmlFor="register-password">Password</label>
        <input id="register-password" type="password" autoComplete="new-password" placeholder="At least 8 characters" minLength={8} maxLength={128} required value={password} onChange={e => setPassword(e.target.value)} />
        <label htmlFor="register-role">I want to join as</label>
        <select id="register-role" value={role} onChange={e => setRole(e.target.value as 'driver' | 'owner')}>
          <option value="driver">EV Driver</option>
          <option value="owner">Charging Station Owner</option>
        </select>
        <button className="button button-primary auth-submit" type="submit" disabled={submitting}>
          {submitting ? 'Creating account...' : 'Create account'} <ArrowRight size={17} />
        </button>
      </form>
      <p className="auth-switch">Already have an account? <Link to="/login">Sign in</Link></p>
      <Link className="back-home" to="/">← Back to home</Link>
    </AuthShell>
  )
}

function ProtectedLayout() {
  const { user, loading, logout } = useAuth()

  if (loading) return <div className="screen-loading">Loading your account...</div>
  if (!user) return <Navigate to="/login" replace />

  return (
    <div className="dashboard-layout">
      <aside className="dashboard-sidebar">
        <Brand />
        <span className="sidebar-caption">WORKSPACE</span>
        <Link to="/stations" className="side-link active"><LayoutDashboard size={18} /> Stations</Link>
        {user.role === 'driver' && (
          <Link to="/bookings" className="side-link"><CalendarDays size={18} /> My Bookings</Link>
        )}
        <Link to="/assistant" className="side-link"><Bot size={18} /> AI Assistant</Link>
        <div className="sidebar-bottom">
          <div className="user-mini"><CircleUserRound size={21} /><span><strong>{user.name}</strong><small>{user.role}</small></span></div>
          <button className="side-link logout-button" onClick={logout}><LogOut size={18} /> Sign out</button>
        </div>
      </aside>
      <div className="dashboard-main">
        <header className="dashboard-topbar">
          <span>YOUR CHARGING WORKSPACE</span>
          <span className="topbar-user">{user.email}</span>
        </header>
        <Outlet />
      </div>
    </div>
  )
}

function StationsPage() {
  const { user } = useAuth()
  const [stations, setStations] = useState<Station[]>([])
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState('')
  const [search, setSearch] = useState('')
  const [connector, setConnector] = useState('all')
  const [availability, setAvailability] = useState('all')
  const [reloadKey, setReloadKey] = useState(0)

  useEffect(() => {
    let active = true

    const loadStations = async () => {
      setLoading(true)
      setError('')

      try {
        const result = await stationsApi.list(0, 100)
        if (active) setStations(result)
      } catch (err) {
        if (active) {
          setError(
            err instanceof Error
              ? err.message
              : 'Unable to load charging stations.',
          )
        }
      } finally {
        if (active) setLoading(false)
      }
    }

    void loadStations()

    return () => {
      active = false
    }
  }, [reloadKey])

  const connectorOptions = useMemo(() => {
    const values = stations.flatMap(station => station.connectors ?? [])
    return [...new Set(values)].sort((a, b) => a.localeCompare(b))
  }, [stations])

  const filteredStations = useMemo(() => {
    const term = search.trim().toLowerCase()

    return stations.filter(station => {
      const searchableText = [
        station.name,
        station.location,
        station.address,
        station.description,
        station.charger_type,
        ...(station.connectors ?? []),
      ].filter(Boolean).join(' ').toLowerCase()

      const matchesSearch = !term || searchableText.includes(term)
      const matchesConnector =
        connector === 'all' ||
        (station.connectors ?? []).some(
          item => item.toLowerCase() === connector.toLowerCase(),
        )
      const matchesAvailability =
        availability === 'all' ||
        (availability === 'available' && station.available_slots > 0) ||
        (availability === 'full' && station.available_slots <= 0)

      return matchesSearch && matchesConnector && matchesAvailability
    })
  }, [stations, search, connector, availability])

  const availableStations = stations.filter(
    station => station.available_slots > 0,
  ).length

  const availablePorts = stations.reduce(
    (total, station) => total + Math.max(station.available_slots, 0),
    0,
  )

  const formatPrice = (price: number) =>
    new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: 'INR',
      maximumFractionDigits: 2,
    }).format(price)

  return (
    <section className="dashboard-content stations-page">
      <div className="stations-heading">
        <div>
          <span className="eyebrow">CHARGING NETWORK</span>
          <h1>Find your next charge{user?.name ? `, ${user.name.split(' ')[0]}` : ''}.</h1>
          <p className="dashboard-intro">
            Explore charging stations, compare connector options, and find an available charging point.
          </p>
        </div>
        <button
          type="button"
          className="stations-refresh"
          onClick={() => setReloadKey(value => value + 1)}
          disabled={loading}
        >
          <RefreshCw size={16} className={loading ? 'stations-spinning' : ''} />
          Refresh
        </button>
      </div>

      <div className="stations-stats">
        <article className="stations-stat">
          <span className="stations-stat-icon"><MapPin size={19} /></span>
          <div>
            <strong>{loading ? '—' : stations.length}</strong>
            <span>Active stations</span>
          </div>
        </article>
        <article className="stations-stat">
          <span className="stations-stat-icon"><Zap size={19} /></span>
          <div>
            <strong>{loading ? '—' : availableStations}</strong>
            <span>With availability</span>
          </div>
        </article>
        <article className="stations-stat">
          <span className="stations-stat-icon"><BatteryCharging size={19} /></span>
          <div>
            <strong>{loading ? '—' : availablePorts}</strong>
            <span>Available charging slots</span>
          </div>
        </article>
      </div>

      <div className="stations-toolbar">
        <label className="stations-search">
          <Search size={19} />
          <input
            type="search"
            placeholder="Search by station, city, or address..."
            value={search}
            onChange={event => setSearch(event.target.value)}
            aria-label="Search charging stations"
          />
        </label>

        <label className="stations-filter">
          <span>Connector</span>
          <select
            value={connector}
            onChange={event => setConnector(event.target.value)}
            aria-label="Filter by connector"
          >
            <option value="all">All connectors</option>
            {connectorOptions.map(option => (
              <option key={option} value={option}>{option}</option>
            ))}
          </select>
        </label>

        <label className="stations-filter">
          <span>Availability</span>
          <select
            value={availability}
            onChange={event => setAvailability(event.target.value)}
            aria-label="Filter by availability"
          >
            <option value="all">All stations</option>
            <option value="available">Available now</option>
            <option value="full">Fully occupied</option>
          </select>
        </label>
      </div>

      <div className="stations-results-heading">
        <div>
          <h2>Charging stations</h2>
          <p>
            {loading
              ? 'Fetching the latest station information...'
              : `${filteredStations.length} station${filteredStations.length === 1 ? '' : 's'} found`}
          </p>
        </div>
      </div>

      {loading && (
        <div className="stations-state" role="status">
          <span className="stations-loader" />
          <strong>Finding charging stations</strong>
          <p>Connecting to your ChargeMate network...</p>
        </div>
      )}

      {!loading && error && (
        <div className="stations-state stations-error" role="alert">
          <h2>We couldn't load the stations.</h2>
          <p>{error}</p>
          <button
            type="button"
            className="button button-primary"
            onClick={() => setReloadKey(value => value + 1)}
          >
            Try again <RefreshCw size={16} />
          </button>
        </div>
      )}

      {!loading && !error && stations.length === 0 && (
        <div className="stations-state">
          <span className="stations-empty-icon"><MapPin size={25} /></span>
          <h2>No active stations yet</h2>
          <p>There are currently no active charging stations in the network.</p>
        </div>
      )}

      {!loading && !error && stations.length > 0 && filteredStations.length === 0 && (
        <div className="stations-state">
          <span className="stations-empty-icon"><Search size={25} /></span>
          <h2>No matching stations</h2>
          <p>Try changing your search or filters to see more results.</p>
          <button
            type="button"
            className="stations-clear"
            onClick={() => {
              setSearch('')
              setConnector('all')
              setAvailability('all')
            }}
          >
            Clear filters
          </button>
        </div>
      )}

      {!loading && !error && filteredStations.length > 0 && (
        <div className="stations-grid">
          {filteredStations.map(station => {
            const hasAvailability = station.available_slots > 0

            return (
              <article className="station-card" key={station.id}>
                <div className="station-card-top">
                  <span className="station-card-icon">
                    <BatteryCharging size={23} />
                  </span>
                  <span className={`station-status ${hasAvailability ? 'is-available' : 'is-full'}`}>
                    <span />
                    {hasAvailability ? 'Available' : 'Fully occupied'}
                  </span>
                </div>

                <h3>{station.name}</h3>

                <p className="station-location">
                  <MapPin size={15} />
                  {station.location || station.address || 'Location not provided'}
                </p>

                {station.address && station.address !== station.location && (
                  <p className="station-address">{station.address}</p>
                )}

                {station.description && (
                  <p className="station-description">{station.description}</p>
                )}

                <div className="station-specs">
                  <div>
                    <span>Charging power</span>
                    <strong>{station.power} kW</strong>
                  </div>
                  <div>
                    <span>Charging speed</span>
                    <strong>{station.speed || 'Not specified'}</strong>
                  </div>
                  <div>
                    <span>Available slots</span>
                    <strong>{station.available_slots} / {station.total_slots}</strong>
                  </div>
                </div>

                <div className="station-connectors">
                  <span>CONNECTORS</span>
                  <div>
                    {(station.connectors ?? []).length > 0
                      ? station.connectors!.map(item => (
                          <span className="connector-chip" key={item}>{item}</span>
                        ))
                      : <span className="connector-unknown">Not specified</span>}
                  </div>
                </div>

                <div className="station-card-footer">
                  <div>
                    <strong>{formatPrice(station.price_per_kwh)}</strong>
                    <span>per kWh</span>
                  </div>
                  <span className="station-network-label">CHARGEMATE NETWORK</span>
                </div>
              </article>
            )
          })}
        </div>
      )}
    </section>
  )
}

interface AssistantMessage {
  id: string
  role: 'user' | 'assistant'
  content: string
}

function AssistantPage() {
  const { user } = useAuth()
  const [conversations, setConversations] = useState<Conversation[]>([])
  const [activeConversationId, setActiveConversationId] = useState<string | null>(null)
  const [messages, setMessages] = useState<AssistantMessage[]>([])
  const [draft, setDraft] = useState('')
  const [loading, setLoading] = useState(false)
  const [historyLoading, setHistoryLoading] = useState(true)
  const [error, setError] = useState('')
  const [pendingConfirmation, setPendingConfirmation] =
    useState<Record<string, unknown> | null>(null)

  useEffect(() => {
    let active = true

    conversationsApi.list()
      .then((items) => {
        if (active) setConversations(items)
      })
      .catch(() => {
        if (active) setError('Your previous conversations could not be loaded.')
      })
      .finally(() => {
        if (active) setHistoryLoading(false)
      })

    return () => {
      active = false
    }
  }, [])

  const startNewConversation = () => {
    setActiveConversationId(null)
    setMessages([])
    setDraft('')
    setError('')
    setPendingConfirmation(null)
  }

  const openConversation = async (id: string) => {
    if (loading || id === activeConversationId) return

    setHistoryLoading(true)
    setError('')

    try {
      const detail = await conversationsApi.get(id)
      setActiveConversationId(detail.id)
      setMessages(
        detail.messages
          .filter((message) => message.role === 'user' || message.role === 'assistant')
          .map((message) => ({
            id: message.id,
            role: message.role as 'user' | 'assistant',
            content: message.content,
          })),
      )

      const latestAssistant = [...detail.messages]
        .reverse()
        .find((message) => message.role === 'assistant')

      const pending = latestAssistant?.metadata_json?.pending_confirmation
      setPendingConfirmation(
        pending && typeof pending === 'object'
          ? pending as Record<string, unknown>
          : null,
      )
    } catch {
      setError('Unable to open this conversation. Please try again.')
    } finally {
      setHistoryLoading(false)
    }
  }

  const sendMessage = async (
    messageText = draft,
    confirmationAction?: 'confirm' | 'reject',
  ) => {
    const message = messageText.trim()
    if (!message || loading) return

    setError('')
    setDraft('')
    setLoading(true)

    setMessages((current) => [
      ...current,
      {
        id: `user-${Date.now()}`,
        role: 'user',
        content: message,
      },
    ])

    try {
      const result = await chatApi.send({
        message,
        conversation_id: activeConversationId,
        confirmation_action: confirmationAction ?? null,
      })

      setActiveConversationId(result.conversation_id)
      setMessages((current) => [
        ...current,
        {
          id: result.message_id ?? `assistant-${Date.now()}`,
          role: 'assistant',
          content: result.response,
        },
      ])

      setPendingConfirmation(result.pending_confirmation)

      const updatedConversations = await conversationsApi.list()
      setConversations(updatedConversations)
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : 'The assistant could not respond. Please try again.',
      )
    } finally {
      setLoading(false)
    }
  }

  return (
    <section className="assistant-page">
      <header className="assistant-heading">
        <div>
          <span className="eyebrow">YOUR INTELLIGENT EV COMPANION</span>
          <h1>Meet your ChargeMate assistant.</h1>
          <p>Find charging stations, check availability and get help with your EV journey.</p>
        </div>
        <div className="assistant-online">
          <span />
          AI ASSISTANT
        </div>
      </header>

      <div className="assistant-shell">
        <aside className="assistant-history">
          <button
            type="button"
            className="assistant-new-chat"
            onClick={startNewConversation}
            disabled={loading}
          >
            <Plus size={17} /> New conversation
          </button>

          <div className="assistant-history-label">RECENT CONVERSATIONS</div>

          {historyLoading && conversations.length === 0 ? (
            <p className="assistant-history-empty">Loading conversations...</p>
          ) : conversations.length === 0 ? (
            <p className="assistant-history-empty">Your conversations will appear here.</p>
          ) : (
            <div className="assistant-history-list">
              {conversations.map((conversation) => (
                <button
                  type="button"
                  key={conversation.id}
                  className={`assistant-history-item ${
                    activeConversationId === conversation.id ? 'active' : ''
                  }`}
                  onClick={() => void openConversation(conversation.id)}
                  disabled={loading}
                >
                  <MessageSquare size={16} />
                  <span>{conversation.title || 'New conversation'}</span>
                </button>
              ))}
            </div>
          )}

          <div className="assistant-history-footer">
            <ShieldCheck size={16} />
            Your account-secured assistant
          </div>
        </aside>

        <div className="assistant-chat">
          <div className="assistant-chat-top">
            <div className="assistant-avatar"><Bot size={21} /></div>
            <div>
              <strong>ChargeMate AI</strong>
              <span>Personal EV charging assistant</span>
            </div>
            <span className="assistant-role">{user?.role ?? 'USER'}</span>
          </div>

          <div className="assistant-messages" aria-live="polite">
            {messages.length === 0 && !historyLoading ? (
              <div className="assistant-welcome">
                <div className="assistant-welcome-icon"><Sparkles size={27} /></div>
                <span className="eyebrow">SMARTER CHARGING STARTS HERE</span>
                <h2>How can I help you today?</h2>
                <p>Ask me about charging stations, connector compatibility, availability or your charging journey.</p>

                <div className="assistant-suggestions">
                  {[
                    'Find available charging stations in Hyderabad',
                    'Show me stations with DC fast charging',
                    'How do I find a compatible charger?',
                  ].map((suggestion) => (
                    <button
                      type="button"
                      key={suggestion}
                      onClick={() => setDraft(suggestion)}
                    >
                      {suggestion}
                      <ArrowRight size={15} />
                    </button>
                  ))}
                </div>
              </div>
            ) : (
              <div className="assistant-message-list">
                {messages.map((message) => (
                  <article
                    className={`assistant-message ${message.role}`}
                    key={message.id}
                  >
                    {message.role === 'assistant' && (
                      <span className="assistant-message-avatar"><Bot size={17} /></span>
                    )}
                    <div className="assistant-message-bubble">
                      <span className="assistant-message-author">
                        {message.role === 'user' ? 'You' : 'ChargeMate AI'}
                      </span>
                      <p>{message.content}</p>
                    </div>
                  </article>
                ))}

                {loading && (
                  <div className="assistant-typing">
                    <span /><span /><span />
                    <small>ChargeMate is thinking...</small>
                  </div>
                )}
              </div>
            )}
          </div>

          {pendingConfirmation && (
            <div className="assistant-confirmation">
              <div>
                <strong>Confirmation required</strong>
                <p>Please review the proposed action before continuing.</p>
                <pre>{JSON.stringify(pendingConfirmation, null, 2)}</pre>
              </div>
              <div className="assistant-confirmation-actions">
                <button
                  type="button"
                  onClick={() => void sendMessage('Confirm the proposed action.', 'confirm')}
                  disabled={loading}
                >
                  Confirm
                </button>
                <button
                  type="button"
                  onClick={() => void sendMessage('Reject the proposed action.', 'reject')}
                  disabled={loading}
                >
                  Reject
                </button>
              </div>
            </div>
          )}

          {error && <div className="assistant-error" role="alert">{error}</div>}

          <form
            className="assistant-composer"
            onSubmit={(event) => {
              event.preventDefault()
              void sendMessage()
            }}
          >
            <input
              value={draft}
              onChange={(event) => setDraft(event.target.value)}
              placeholder="Ask ChargeMate anything about EV charging..."
              maxLength={4000}
              aria-label="Message ChargeMate AI"
              disabled={loading}
            />
            <button
              type="submit"
              aria-label="Send message"
              disabled={loading || !draft.trim()}
            >
              <Send size={18} />
            </button>
          </form>
          <p className="assistant-disclaimer">
            ChargeMate AI uses your authenticated account to access available services.
          </p>
        </div>
      </div>
    </section>
  )
}

function NotFoundPage() {
  return (
    <div className="not-found">
      <span className="eyebrow">404 · PAGE NOT FOUND</span>
      <h1>We couldn't find that page.</h1>
      <Link to="/" className="button button-primary">Back to home <ArrowRight size={17} /></Link>
    </div>
  )
}

function App() {
  return (
    <Routes>
      <Route path="/" element={<LandingPage />} />
      <Route path="/login" element={<LoginPage />} />
      <Route path="/register" element={<RegisterPage />} />
      <Route element={<ProtectedLayout />}>
        <Route path="/stations" element={<StationsPage />} />
        <Route path="/bookings" element={<BookingsPage />} />
        <Route path="/assistant" element={<AssistantPage />} />
      </Route>
      <Route path="*" element={<NotFoundPage />} />
    </Routes>
  )
}

export default App
