    <Link to="/" className={`brand ${light ? 'brand-light' : ''}`}>
      <span className="brand-mark">
        <BatteryCharging size={24} strokeWidth={2.1} />
      </span>
      <span className="brand-word">
        <span>Charge<span className="brand-accent">Mate</span></span>
        <small>INTELLIGENT EV NETWORK</small>
      </span>
    </Link>
  )
}

